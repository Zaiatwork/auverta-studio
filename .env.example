# Copy to .env.local for local overrides. All values are optional; the defaults are production.
# These are public, build-time values for the static export (never put secrets here).
# Server secrets (database, mail) live in the PHP config: backend/config.example.php.

# Canonical origin, no trailing slash. Drives metadata, sitemap, robots and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://auverta.studio

# Inbox shown on the site and in structured data.
NEXT_PUBLIC_CONTACT_EMAIL=info@auverta.studio

# Where /api/*.php lives. Leave empty for same-origin. For `npm run dev` against a deployed
# backend, set the full origin (and add http://localhost:3000 to allowed_origins in the PHP config).
NEXT_PUBLIC_API_BASE_URL=
